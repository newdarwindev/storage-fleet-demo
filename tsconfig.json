{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vite/client"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "tests/**/*.js",
    "scripts/**/*.js",
    "playwright.config.js"
  ]
}
